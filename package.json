{
  "name": "hono-inertia",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "dev:wrangler": "wrangler dev --local --assets dist --port 8787",
    "build": "vite build && node tools/gen-manifest-module.mjs",
    "test:prod": "npm run build && wrangler dev --local -e prod",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@inertiajs/core": "^1.0.14",
    "@inertiajs/react": "^1.0.14",
    "hono": "^4.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.1.4",
    "wrangler": "^4.28.1"
  }
}